# ==============================================================================
# The Blind Spot - Environment Variables Configuration
# ==============================================================================

# Gemini API Key (Required for live AI thinking analysis)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Environment (development, testing, production)
APP_ENV=production
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=20

# Request Cache TTL in seconds (1 hour = 3600)
CACHE_TTL_SECONDS=3600

# Server-Side Session History Size Cap
MAX_SESSION_HISTORY=10
